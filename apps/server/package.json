{
  "name": "@stratosonic/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @stratosonic/admin build && wrangler dev",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "bench:console-auth": "tsx --import ./scripts/bench-register.mjs scripts/bench-console-auth.ts",
    "bench:file-uploads": "tsx --import ./scripts/bench-register.mjs scripts/bench-file-uploads.ts",
    "bench:files": "tsx scripts/bench-files.ts",
    "bench:s3-list": "tsx scripts/bench-s3-list-workerd.ts",
    "bench:startup": "node scripts/bench-startup.mjs",
    "cf-typegen": "wrangler types --include-runtime=false --strict-vars=false --env-file /dev/null",
    "typecheck": "pnpm run cf-typegen && tsc --noEmit",
    "test": "vitest run && pnpm run test:routing",
    "test:routing": "pnpm --filter @stratosonic/admin build && vitest run --config vitest.routing.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.6",
    "@stratosonic/db": "workspace:*",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.8",
    "music-metadata": "11.15.0",
    "strtok3": "10.3.5"
  },
  "devDependencies": {
    "@better-auth/utils": "0.4.2",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "^5.20260918.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.124.0"
  }
}
