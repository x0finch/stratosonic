{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stratosonic",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  // Required by the Workers Vitest integration.
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // The Scan runs from the `scheduled` entry (ADR-0004). One run is a bounded
  // step that resumes from a cursor it left in the `property` table, so the
  // schedule is what carries a large library to a complete pass; every
  // quarter hour keeps a freshly uploaded album a few runs away at most,
  // while an unchanged bucket costs a listing and nothing else.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  // `INITIAL_PASSWORD` and `PASSWORD_ENCRYPTION_KEY` are Worker secrets and are
  // deliberately absent here; only the non-secret username is a plain var.
  // Set them once per environment with `wrangler secret put INITIAL_PASSWORD`
  // and `wrangler secret put PASSWORD_ENCRYPTION_KEY`; `wrangler dev` reads
  // them from `.dev.vars` (see .dev.vars.example).
  "vars": {
    "INITIAL_USER": "admin"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stratosonic",
      // Placeholder: replaced with the real id once the D1 database exists.
      "database_id": "00000000-0000-0000-0000-000000000000",
      // Migrations are generated by drizzle-kit in packages/db and applied with
      // `wrangler d1 migrations apply`.
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MUSIC",
      "bucket_name": "navidrome"
    }
  ],
  // Named environments do not inherit vars or bindings, so the preview
  // environment repeats them alongside its own Worker name.
  "env": {
    "preview": {
      "name": "stratosonic-preview",
      "triggers": {
        "crons": ["*/15 * * * *"]
      },
      "vars": {
        "INITIAL_USER": "admin"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "stratosonic-preview",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MUSIC",
          "bucket_name": "navidrome"
        }
      ]
    }
  }
}
