{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stratosonic",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  // Required by the Workers Vitest integration.
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // The admin console (apps/admin, #87): a single-page app served as static
  // assets, which cost no Worker invocation and do not count toward the free
  // plan's daily requests. Only the paths the Worker owns reach it: the
  // Subsonic API, the public image URLs and the console's JSON API. A pattern
  // ending in `/*` does not match its bare prefix, so `/rest` and `/api` are
  // listed as well; `/share` has no route of its own. Every other path is an
  // asset, and one that matches no file is the console's index.html, so `/`
  // and a deep link to a client route both load the console (test/routing
  // covers both environments).
  //
  // The directory is the console's build output, so `pnpm --filter
  // @stratosonic/admin build` has to run before anything serves or deploys
  // it: the dev and test:routing scripts run it themselves, and so does the
  // deploy workflow. `wrangler types` and the Workers-pool tests read this
  // file without needing the directory.
  "assets": {
    "directory": "../admin/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/rest", "/rest/*", "/share/*", "/api", "/api/*"]
  },
  // The cron pokes the scan driver (ADR-0004, #31). The Scan itself runs one
  // bounded step per Durable Object alarm, and the driver chains the alarms
  // until the pass is done, so the schedule only decides how often a pass
  // *starts* - every quarter hour keeps a freshly uploaded album a few
  // minutes away, while an unchanged bucket costs a listing and nothing else.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  // The scan driver: one instance, named "library", that owns the alarm loop.
  // It stores no library data - D1 remains the source of truth for what a
  // pass has done - so its storage holds only the driver's own bookkeeping.
  "durable_objects": {
    "bindings": [
      {
        "name": "SCAN_DRIVER",
        "class_name": "ScanDriver"
      }
    ]
  },
  // SQLite-backed, which is the only backend the Workers Free plan can create
  // (developers.cloudflare.com/durable-objects/platform/pricing, "Storage
  // billing") and the recommended one for every new class.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ScanDriver"]
    }
  ],
  // The Worker's secrets are deliberately absent here. Set them once per
  // environment with `wrangler secret put`; `wrangler dev` reads them from
  // `.dev.vars` (see .dev.vars.example and README.md):
  //   - `PASSWORD_ENCRYPTION_KEY`, which every Subsonic password is encrypted
  //     under, and which the console's session secret and the pepper of its
  //     console users' password hashes are derived from;
  //   - `SETUP_TOKEN`, at least 32 characters (`openssl rand -hex 32`), which
  //     creates the console's owner at `/setup` on first run, and does
  //     nothing else. It is used once: deleting it afterwards (`wrangler
  //     secret delete SETUP_TOKEN`) is optional, and leaving it has no effect.
  //     A lost owner password is recovered by deleting the owner in D1 and
  //     setting up again with a new value (README.md). Console users are the
  //     console's own accounts, separate from Subsonic users.
  //   - optionally, `CF_ANALYTICS_TOKEN` (an API token with Account › Account
  //     Analytics › Read, limited to this account) and `CF_ACCOUNT_ID` (the
  //     account's id), for the console's free-tier usage panel. Without both
  //     the panel is hidden. The account id is a secret too, so this file
  //     stays account-agnostic.
  //
  // Deprecated: `INITIAL_USER` below and the `INITIAL_PASSWORD` secret create
  // the first Subsonic user, an admin, on first run. They still work in this
  // release, and are how a Subsonic user is created until the console manages
  // them, but they keep a password in the secrets and never make a console
  // user.
  "vars": {
    "INITIAL_USER": "admin"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stratosonic_db",
      "database_id": "9f5dd52d-cff2-4404-9859-2049e9dc86f9",
      // Migrations are generated by drizzle-kit in packages/db and applied with
      // `wrangler d1 migrations apply`.
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MUSIC",
      "bucket_name": "navidrome"
    }
  ],
  // Named environments do not inherit vars or bindings, so the preview
  // environment repeats them alongside its own Worker name.
  "env": {
    "preview": {
      "name": "stratosonic-preview",
      "assets": {
        "directory": "../admin/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/rest", "/rest/*", "/share/*", "/api", "/api/*"]
      },
      "triggers": {
        "crons": ["*/15 * * * *"]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "SCAN_DRIVER",
            "class_name": "ScanDriver"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["ScanDriver"]
        }
      ],
      // Deprecated, as at the top level: the first Subsonic user only.
      "vars": {
        "INITIAL_USER": "admin"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "stratosonic-preview",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MUSIC",
          "bucket_name": "navidrome"
        }
      ]
    }
  }
}
