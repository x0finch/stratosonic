# Worker secrets, for `wrangler dev`. Copy this file to `.dev.vars` and put real
# values in it; `.dev.vars` is git-ignored and must never be committed.
#
# In production these are set once per environment, and are never written to
# wrangler.jsonc:
#
#   wrangler secret put PASSWORD_ENCRYPTION_KEY
#   wrangler secret put SETUP_TOKEN
#
# Passphrase the AES-GCM key that encrypts stored passwords is derived from
# (ADR-0003), and the admin console's session secret too. Changing it after
# users exist makes their passwords unreadable, and nobody can log in.
PASSWORD_ENCRYPTION_KEY = "change-me-too"

# One-time token that creates the first admin in the console (/setup) while
# there are no users, and resets an admin's password (/setup/reset) once there
# are. At least 32 characters, or it is ignored; generate one with
# `openssl rand -hex 32`. Each value works once: to recover again, set a new one.
# This placeholder is too short, so setup stays closed until it is replaced.
SETUP_TOKEN = "change-me"

# Deprecated: use SETUP_TOKEN. Password of the admin user created on first run,
# alongside the INITIAL_USER var in wrangler.jsonc. It is only read while the
# user table is empty, and still works in this release.
# INITIAL_PASSWORD = "change-me"
