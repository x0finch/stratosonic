# Worker secrets, for `wrangler dev`. Copy this file to `.dev.vars` and put real
# values in it; `.dev.vars` is git-ignored and must never be committed.
#
# In production these are set once per environment, and are never written to
# wrangler.jsonc:
#
#   wrangler secret put PASSWORD_ENCRYPTION_KEY
#   wrangler secret put SETUP_TOKEN
#
# and, optionally, for the console's usage panel:
#
#   wrangler secret put CF_ANALYTICS_TOKEN
#   wrangler secret put CF_ACCOUNT_ID
#
# Passphrase the AES-GCM key that encrypts stored Subsonic passwords is derived
# from (ADR-0003), and the admin console's session secret and the pepper of its
# users' password hashes too (ADR-0007). Changing it after users exist makes
# their passwords unreadable, and nobody can log in.
PASSWORD_ENCRYPTION_KEY = "change-me-too"

# One-time token that creates the console's owner (/setup) while there is no
# console user, and does nothing else. Console users are the console's own
# accounts, not Subsonic users. At least 32 characters, or it is ignored;
# generate one with `openssl rand -hex 32`. Each value works once; leaving it
# set after setup has no effect. This placeholder is too short, so setup stays
# closed until it is replaced.
SETUP_TOKEN = "change-me"

# Optional: the console's free-tier usage panel, which reads Cloudflare's
# GraphQL Analytics API. CF_ANALYTICS_TOKEN is an API token with Account ›
# Account Analytics › Read, limited to the one account; CF_ACCOUNT_ID is that
# account's id (README.md). Without both, the panel is hidden.
# CF_ANALYTICS_TOKEN = ""
# CF_ACCOUNT_ID = ""

# Deprecated: password of the Subsonic admin user created on first run,
# alongside the INITIAL_USER var in wrangler.jsonc. It is only read while the
# Subsonic user table is empty. It still works in this release, beside the
# console, which creates Subsonic users too; it never makes a console user.
# INITIAL_PASSWORD = "change-me"
